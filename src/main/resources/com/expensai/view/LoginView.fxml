<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" styleClass="auth-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.expensai.controller.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label styleClass="auth-title" text="ExpensAI Login" />
    <VBox spacing="10.0">
        <Label text="Username or Email:" />
        <TextField fx:id="usernameField" promptText="Enter username or email" />
    </VBox>
    <VBox spacing="10.0">
        <Label text="Password:" />
        <PasswordField fx:id="passwordField" promptText="Enter your password" />
    </VBox>
    <Button fx:id="loginButton" mnemonicParsing="false" text="Login" styleClass="primary-button" />
    <Button fx:id="registerButton" mnemonicParsing="false" text="Don't have an account? Register" styleClass="link-button" />
    <Label fx:id="errorMessageLabel" styleClass="error-message" textFill="red" />
</VBox> 