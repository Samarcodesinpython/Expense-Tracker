<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expensai.controller.ManageCategoriesController">
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <Label text="Manage Categories" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
            
            <GridPane hgap="10" vgap="10">
                <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label text="Color:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ColorPicker fx:id="colorPicker" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label text="Icon:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <ComboBox fx:id="iconComboBox" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                
                <Label text="Monthly Budget (₹):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="budgetField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </GridPane>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Add Category" onAction="#handleAddCategory" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                <Button text="Update Category" onAction="#handleUpdateCategory" style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
                <Button text="Delete Category" onAction="#handleDeleteCategory" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
            </HBox>
            
            <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="150" />
                    <TableColumn fx:id="colorColumn" text="Color" prefWidth="100" />
                    <TableColumn fx:id="iconColumn" text="Icon" prefWidth="100" />
                    <TableColumn fx:id="budgetColumn" text="Budget (₹)" prefWidth="120" />
                    <TableColumn fx:id="spentColumn" text="Spent (₹)" prefWidth="120" />
                    <TableColumn fx:id="remainingColumn" text="Remaining (₹)" prefWidth="120" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane> 