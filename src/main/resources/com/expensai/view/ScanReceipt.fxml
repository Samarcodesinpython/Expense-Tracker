<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expensai.controller.ScanReceiptController">
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <Label text="Scan Receipt" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
            
            <HBox spacing="20" alignment="CENTER">
                <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #f5f5f5; -fx-background-radius: 10;">
                    <Label text="Camera Scan" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    <ImageView fx:id="cameraPreview" fitWidth="300" fitHeight="200" preserveRatio="true" />
                    <Button fx:id="startCameraButton" text="Start Camera" />
                    <Button fx:id="captureButton" text="Capture" disable="true" />
                </VBox>
                
                <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #f5f5f5; -fx-background-radius: 10;">
                    <Label text="File Upload" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    <ImageView fx:id="filePreview" fitWidth="300" fitHeight="200" preserveRatio="true" />
                    <Button fx:id="browseButton" text="Browse File" />
                </VBox>
            </HBox>
            
            <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #f5f5f5; -fx-background-radius: 10;">
                <Label text="Receipt Details" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                <GridPane hgap="10" vgap="10">
                    <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    
                    <Label text="Amount:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="amountField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    
                    <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <ComboBox fx:id="categoryComboBox" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    
                    <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextArea fx:id="descriptionArea" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                </GridPane>
            </VBox>
            
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="saveButton" text="Save Receipt" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                <Button fx:id="cancelButton" text="Cancel" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
            </HBox>
        </VBox>
    </center>
</BorderPane>