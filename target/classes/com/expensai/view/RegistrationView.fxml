<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" styleClass="auth-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.expensai.controller.RegistrationController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label styleClass="auth-title" text="ExpensAI Registration" />
    <VBox spacing="10.0">
        <Label text="Username:" />
        <TextField fx:id="usernameField" promptText="Choose a username" />
    </VBox>
     <VBox spacing="10.0">
        <Label text="Email:" />
        <TextField fx:id="emailField" promptText="Enter your email" />
    </VBox>
    <VBox spacing="10.0">
        <Label text="Password:" />
        <PasswordField fx:id="passwordField" promptText="Choose a password" />
    </VBox>
     <VBox spacing="10.0">
        <Label text="Confirm Password:" />
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" />
    </VBox>
    <Button fx:id="registerButton" mnemonicParsing="false" text="Register" styleClass="primary-button" />
    <Button fx:id="loginButton" mnemonicParsing="false" text="Already have an account? Login" styleClass="link-button" />
    <Label fx:id="errorMessageLabel" styleClass="error-message" textFill="red" />
</VBox> 